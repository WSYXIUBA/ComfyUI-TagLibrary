# 代码与出厂数据进仓库/进包
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
node.zip
tests/*.png
ComfyUI-TagLibrary-*.zip

# 写盘前自动留的 .bak (save_* / 迁移脚本生成, 不是数据真源)
data/default/taglib/*.bak
data/default/taglib/*.pre-*.bak

# 备份: 只排除用户个人数据和脚本 (出厂备份进包, 随升级覆盖)
# v1.1.1: 数据分级 data/default/, 备份英文命名
data/default/backups/user_backup.json
data/default/backups/_trash/
data/default/backups/*.bat
data/default/backups/*.ps1
data/default/backups/*.sh
data/default/backups/*.cmd
data/default/backups/.upgrade-pending

# 旧布局 (v1.1.0 及更早, 升级自动迁移后遗留)
data/备份库/
data/备份库/tag_library.用户.backup.json
data/备份库/_trash/
data/备份库/.升级待确认

# 智能体工作区 (项目记忆/日志, 非插件代码)
.workbuddy/

# 数据修复脚本的自动备份 (tools/*.py 生成, 不入库)
data/default/*.bak-*
# data 脚本的自动备份 (含子目录)
data/**/*.bak-*

# comfy node publish 的临时 changelog 片段
.release_changelog.tmp

# ---- 1.8.0 扩展包 (NSFW 体系, 合规隔离: 不入 git / 不入发布包) ----
data/default/tag_library.ext.json
data/default/taglib/nsfw_grouprules.json
data/default/taglib/nsfw_conflicts.json
data/packs/
data/default/taglib/nsfw_nl.json
data/default/tag_library.user.json
